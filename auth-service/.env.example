# Copy to .env and fill in production values
DB_HOST=localhost
DB_PORT=5432
DB_NAME=user_auth_db
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=your-256-bit-secret-key-here
JWT_EXPIRY=60
INTERNAL_API_KEY=your-shared-internal-api-key-here
# ADMIN seeding - leave blank to skip
ADMIN_EMAIL=admin@marketplace.local
ADMIN_PHONE=+10000000000
ADMIN_PASSWORD=
