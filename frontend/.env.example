# For `npm run dev` only: the dev server is its own origin on :5173, so it needs the
# gateway's absolute address and the CORS allowance that nginx.conf grants it.
#
# The container build sets this to the empty string instead. There the gateway serves
# the bundle and the API from one port, so every request is relative and no origin is
# baked into the JavaScript.
VITE_API_URL=http://localhost:8080
