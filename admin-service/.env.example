# Copy to .env and fill in production values
DB_HOST=localhost
DB_PORT=5432
DB_NAME=admin_contact_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
# JWT_SECRET and INTERNAL_API_KEY must be byte-identical to every other service:
# tokens are verified locally and the internal key is one shared secret.
JWT_SECRET=your-256-bit-secret-key-here
INTERNAL_API_KEY=your-shared-internal-api-key-here
# Admin/Contact is downstream of everything: it decides offers, reads the demand
# behind them, and resolves the identities a contact grant is written against.
OFFER_SERVICE_URL=http://localhost:8085
REQUEST_SERVICE_URL=http://localhost:8084
CUSTOMER_SERVICE_URL=http://localhost:8082
SELLER_SERVICE_URL=http://localhost:8083
AUTH_SERVICE_URL=http://localhost:8081
# Broker for notification events (see docs/events.md).
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
SERVER_PORT=8086
