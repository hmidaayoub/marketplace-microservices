    {
      "name": "8. Session teardown",
      "item": [
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Refresh-Token",
                "value": "{{refreshToken}}"
              }
            ],
            "url": "{{authUrl}}/api/auth/refresh",
            "description": "Rotates: the presented refresh token is revoked and replaced. Replaying the old one returns 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", b.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", b.refreshToken);",
                  "pm.test(\"token was rotated\", () => pm.expect(pm.response.json().refreshToken).to.not.eql(pm.collectionVariables.get(\"refreshToken\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{authUrl}}/api/auth/logout",
            "description": "Revokes every outstanding refresh token for this user. Refresh afterwards returns 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Run last. Refresh rotates the token; logout revokes every refresh token for the user, so anything after this needs a fresh login."
    }
  ]
}