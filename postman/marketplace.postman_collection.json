{
  "info": {
    "name": "Marketplace Microservices",
    "description": "Auth (8081), Customer (8082), Seller (8083).\n\nRun **Auth > Register customer** then **Auth > Login** first: login stores accessToken/refreshToken/userId as collection variables, and everything else reads them. **Seller > Register + login seller** does the same for the seller role.\n\nRequests under *Internal* send X-Internal-Api-Key. These are service-to-service endpoints and must never be exposed publicly.\n\nThe *Negative cases* folder documents deliberate 401/403 behaviour.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "authUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "customerUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "sellerUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "internalApiKey",
      "value": "dev-internal-api-key-change-in-production"
    },
    {
      "key": "adminEmail",
      "value": "admin@marketplace.local"
    },
    {
      "key": "adminPassword",
      "value": "admin-dev-password"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "sellerAccessToken",
      "value": ""
    },
    {
      "key": "sellerUserId",
      "value": ""
    },
    {
      "key": "sellerId",
      "value": ""
    },
    {
      "key": "adminAccessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/auth/register/customer",
            "description": "409 if the email or phone is already taken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@test.com\",\n  \"password\": \"password123\",\n  \"phoneNumber\": \"+21611111111\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created or already exists\", () =>",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"userId\", pm.response.json().userId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@test.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"accessToken\", b.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", b.refreshToken);",
                  "pm.test(\"expiresIn matches config\", () => pm.expect(pm.response.json().expiresIn).to.be.a(\"number\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/auth/login",
            "description": "Seeded at startup by AdminBootstrap from ADMIN_PASSWORD.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"adminAccessToken\", b.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
        {
          "name": "Get my account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{authUrl}}/api/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"includes phone (own account)\", () => pm.expect(pm.response.json()).to.have.property(\"phoneNumber\"));",
                  "pm.collectionVariables.set(\"userId\", pm.response.json().userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update my account",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{authUrl}}/api/users/me",
            "description": "409 if the email belongs to someone else.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1.updated@test.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Customer",
      "item": [
        {
          "name": "Create customer profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{customerUrl}}/api/customers",
            "description": "Calls auth-service internally to confirm the caller's role is CUSTOMER. 403 otherwise.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Amine\",\n  \"lastName\": \"Hmida\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created or already exists\", () =>",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{customerUrl}}/api/customers/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{customerUrl}}/api/customers/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Mohamed\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Seller",
      "item": [
        {
          "name": "Register seller",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/auth/register/seller",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seller1@test.com\",\n  \"password\": \"password123\",\n  \"phoneNumber\": \"+21622222222\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created or already exists\", () =>",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"sellerUserId\", pm.response.json().userId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as seller",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seller1@test.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"sellerAccessToken\", b.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create seller profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerAccessToken}}"
              }
            ],
            "url": "{{sellerUrl}}/api/sellers",
            "description": "userId is NOT accepted in the body - it comes from the token subject.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeName\": \"Amine Store\",\n  \"description\": \"Electronics\",\n  \"city\": \"Tunis\",\n  \"address\": \"12 Rue Example\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created or already exists\", () =>",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"sellerId\", pm.response.json().sellerId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my seller profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerAccessToken}}"
              }
            ],
            "url": "{{sellerUrl}}/api/sellers/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"owner sees address\", () => pm.expect(pm.response.json()).to.have.property(\"address\"));",
                  "pm.collectionVariables.set(\"sellerId\", pm.response.json().sellerId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update my seller profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{sellerAccessToken}}"
              }
            ],
            "url": "{{sellerUrl}}/api/sellers/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"Sfax\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get public seller profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{sellerUrl}}/api/sellers/{{sellerId}}",
            "description": "Public projection: no address, no userId. No auth required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"address withheld from public\", () => pm.expect(pm.response.json()).to.not.have.property(\"address\"));",
                  "pm.test(\"userId withheld from public\", () => pm.expect(pm.response.json()).to.not.have.property(\"userId\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Internal (service-to-service)",
      "item": [
        {
          "name": "Get user identity",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internalApiKey}}"
              }
            ],
            "url": "{{authUrl}}/internal/users/{{userId}}",
            "description": "Deliberately excludes the phone number - that has its own restricted endpoint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"phone NOT exposed here\", () => pm.expect(pm.response.json()).to.not.have.property(\"phoneNumber\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get user phone (restricted)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internalApiKey}}"
              }
            ],
            "url": "{{authUrl}}/internal/users/{{userId}}/phone",
            "description": "The only way to obtain a phone number."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve customer by user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internalApiKey}}"
              }
            ],
            "url": "{{customerUrl}}/internal/customers/by-user/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve seller by user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "{{internalApiKey}}"
              }
            ],
            "url": "{{sellerUrl}}/internal/sellers/by-user/{{sellerUserId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Negative cases",
      "item": [
        {
          "name": "No credentials -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{authUrl}}/api/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Garbage token -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not-a-real-token"
              }
            ],
            "url": "{{authUrl}}/api/users/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Spoofed X-User-Id -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": "{{customerUrl}}/api/customers/me",
            "description": "A caller-supplied header must never prove identity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Internal without key -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{authUrl}}/internal/users/{{userId}}/phone"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Internal with wrong key -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Api-Key",
                "value": "wrong-key"
              }
            ],
            "url": "{{authUrl}}/internal/users/{{userId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer creating seller profile -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{sellerUrl}}/api/sellers",
            "description": "Seller service asks auth-service for the role and rejects non-SELLER.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeName\": \"Should Fail\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid registration -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/auth/register/customer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"phoneNumber\": \"nonsense\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"per-field errors\", () => pm.expect(pm.response.json().errors).to.have.property(\"email\"));"
                ]
              }
            }
          ]
        }
      ]
    },
