# Copy to .env and fill in production values
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notification_db
DB_USER=postgres
DB_PASSWORD=postgres
# JWT_SECRET and INTERNAL_API_KEY must be byte-identical to every other service:
# tokens are verified locally and the internal key is one shared secret.
JWT_SECRET=your-256-bit-secret-key-here
INTERNAL_API_KEY=your-shared-internal-api-key-here
# No service URLs: this service is told who to notify and never resolves an identity.
# The broker it consumes notification events from (see docs/events.md).
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
SERVER_PORT=8087
